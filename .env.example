# AstraX Police AI Frontend Configuration Example

# Local Backend (Run `cargo run --bin server` on port 8000)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# Production Deployment (Railway Backend for Vercel Frontend)
# Set these in your Vercel Project Settings -> Environment Variables:
# VITE_API_BASE_URL=https://astrax-backend.up.railway.app
# VITE_USE_MOCK_API=false
